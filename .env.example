# Copy to .env and fill in real values. Never commit .env to version control.
# Keep the file mode at 600: it holds live provider and mail secrets.
#
# Only the variables that docker-compose.rust-production.yml explicitly forwards
# reach the container; anything else here is ignored.

# --- Cutover-critical -------------------------------------------------------
# Host port the Rust service binds. The default is 18088 (the canary port). Set
# it to whatever the reverse proxy already targets, otherwise a later
# `docker compose up -d` comes up on the wrong port and the proxy 502s.
FRICKMAIL_RUST_PORT=8888
# Externally reachable production origin, used for generated links and OIDC
# redirects.
FRICKMAIL_RUST_BASE_URL=https://webmail.example.com
# Revision-tagged image to run. Pin this at cutover so an unqualified
# `up -d` cannot silently move to a different image.
FRICKMAIL_RUST_IMAGE=frickmail-rust:latest
# Existing networks to attach to. These match the defaults in
# docker-compose.rust-production.yml; override only for a differently named
# Compose project.
FRICKMAIL_DB_NETWORK=frickmail_db-network
FRICKMAIL_REDIS_NETWORK=frickmail_redis-network

# --- Database ---------------------------------------------------------------
# Compose passes this to the container as FRICKMAIL_DB_PASSWORD. Setting
# FRICKMAIL_DB_PASSWORD here has no effect.
POSTGRES_PASSWORD=change-me

# --- Outbound mail ----------------------------------------------------------
FRICKMAIL_SMTP_PASSWORD=change-me

# --- OAuth providers --------------------------------------------------------
FRICKMAIL_GMAIL_CLIENT_ID=
FRICKMAIL_GMAIL_CLIENT_SECRET=
FRICKMAIL_O365_CLIENT_ID=
FRICKMAIL_O365_CLIENT_SECRET=

# --- Optional feature keys --------------------------------------------------
# Have I Been Pwned API v3 key for account-breach lookup.
FRICKMAIL__HIBP__API_KEY=

# --- Mail and user behaviour ------------------------------------------------
FRICKMAIL__FRICKMAIL_USER__ALLOW_EXPORT=true
FRICKMAIL__FRICKMAIL_USER__ALLOW_MESSAGE_APPEND=false
FRICKMAIL__FRICKMAIL_USER__SMIME_ENABLED=true
FRICKMAIL__FRICKMAIL_USER__EXPORT_FOLDER_MAX_MESSAGES=5000
FRICKMAIL__FRICKMAIL_USER__EXPORT_FOLDER_MAX_BYTES=26214400
FRICKMAIL__MAIL__FETCH_NEW_MESSAGES=true
FRICKMAIL__MAIL__MESSAGE_LIST_FAST_SIMPLE_SEARCH=true
FRICKMAIL__MAIL__MESSAGE_LIST_PERMANENT_FILTER=
# JSON object keyed by lowercase ASCII/punycode domains or legacy-style wildcard patterns.
FRICKMAIL__MAIL__MESSAGE_LIST_DOMAIN_OVERRIDES={}
# Temporary directory for attachment downloads and uploads. Note: this lives on
# a tmpfs inside the container, so it is empty after every restart — GnuPG
# keyrings under it do not survive one.
FRICKMAIL__TMP_DIR=/tmp/frickmail
